{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "usdtrecovery.xyz"
        }
      ],
      "destination": "https://www.usdtrecovery.xyz/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/cases",
      "destination": "/cases.html"
    },
    {
      "source": "/zh/cases",
      "destination": "/zh/cases.html"
    },
    {
      "source": "/en/cases",
      "destination": "/en/cases.html"
    }
  ]
}
